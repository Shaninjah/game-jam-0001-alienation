/* ============================================================
   APPARENCE CREATURE
   ------------------------------------------------------------
   Config commune a toutes les langues.
   Les mutations normales donnent une direction a la creature.
   Les anomalies prennent le dessus quand l'evolution est poussee
   trop loin.
   ============================================================ */

{
  /* ------------------------------------------------------------
     IMAGE DE BASE
     ------------------------------------------------------------ */
  "base": "assets/creatures/perso.png",

  /* ------------------------------------------------------------
     ORDRE DES CALQUES
     ------------------------------------------------------------
     Le premier calque est pose en dessous, le dernier au-dessus.
     ------------------------------------------------------------ */
  "slots": [
    "tails",
    "ears",
    "eyes",
    "mouths"
  ],

  /* ------------------------------------------------------------
     DIFFICULTE INTERNE DES DEBLOCAGES
     ------------------------------------------------------------ */
  "unlockDifficulty": {
    "enabled": true,
    "incrementPerActivePart": 1,
    "ignoredSlots": [
      "tails"
    ],
    "minimumBaseByTier": {
      "1": 3,
      "2": 6,
      "3": 9
    }
  },

  /* ------------------------------------------------------------
     INSTABILITE
     ------------------------------------------------------------
     La pression monte quand le joueur specialise trop la creature,
     pousse les stats hautes, continue tard dans le protocole ou
     tente de tout optimiser en meme temps.
     Les valeurs restent cote code/design, jamais affichees telles
     quelles au joueur.
     ------------------------------------------------------------ */
  "instability": {
    "enabled": true,
    "max": 18,
    "choicePressure": 0.05,
    "positiveEffectPressure": 0.045,
    "effectPressureScale": 0.6,
    "effectStabilityScale": 1,
    "overdrivePressure": 0.25,
    "dominanceGap": 8,
    "dominancePressure": 0.25,
    "highStatThreshold": 14,
    "highStatPressure": 0.3,
    "lateTestIndex": 5,
    "lateTestPressure": 0.15,
    "dominantShiftPressure": 0.12,
    "balancedGap": 3,
    "balancedRelief": 0.45,
    "balancedHighThreshold": 8,
    "balancedHighGap": 3,
    "balancedHighPressure": 0.75,
    "stageThresholds": {
      "1": 10,
      "2": 14,
      "3": 17
    }
  },

