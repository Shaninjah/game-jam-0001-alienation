{
  "id": "test_10",
  "label": "Behavioral test 10",
  "creatureLabel": "LEVEL 10",
  "startNode": "intro",
  "nodes": {
    "intro": {
      "messages": [
        {
          "speaker": "Professor Chen",
          "emotion": "serious",
          "text": "Tenth protocol. All the data contradicts itself. The more we optimize the creature, the more it loses the ability to surprise us."
        },
        {
          "speaker": "Professor Chen",
          "emotion": "neutral",
          "text": "I am asking you to choose without searching for the perfect answer."
        }
      ],
      "choices": [
        {
          "label": "I accept that it remains imperfect and alive.",
          "effects": {
            "conciliation": 2,
            "intelligence": 1,
            "pressure": 0.35,
            "stability": 1.3,
            "mercy": true
          },
          "next": "dilemme_01"
        },
        {
          "label": "I keep looking for a stable formula, even incomplete.",
          "effects": {
            "intelligence": 2,
            "force": 1,
            "pressure": 0.9,
            "stability": 0.25,
            "overdrive": true
          },
          "next": "dilemme_01"
        },
        {
          "label": "I let it choose its next mutation.",
          "effects": {
            "exploration": 2,
            "pressure": 0.35,
            "stability": 0.7,
            "mercy": true
          },
          "next": "dilemme_01"
        }
      ]
    },
    "dilemme_01": {
      "messages": [
        {
          "speaker": "Professor Chen",
          "emotion": "worried",
          "text": "It stops responding to the gauges. Force, exploration, conciliation, intelligence: it understands them, then ignores them."
        }
      ],
      "choices": [
        {
          "label": "I destroy the test grid before it traps the creature.",
          "effects": {
            "force": 1,
            "exploration": 2,
            "pressure": 1.1,
            "stability": 0.25,
            "overdrive": true
          },
          "next": "decision_finale"
        },
        {
          "label": "I turn the test into an open dialogue.",
          "effects": {
            "conciliation": 2,
            "intelligence": 1,
            "pressure": 0.35,
            "stability": 1.3,
            "mercy": true
          },
          "next": "decision_finale"
        },
        {
          "label": "I measure this refusal precisely so we keep a trace.",
          "effects": {
            "intelligence": 3,
            "pressure": 1.05,
            "overdrive": true
          },
          "next": "decision_finale"
        }
      ]
    },
    "decision_finale": {
      "messages": [
        {
          "speaker": "Professor Chen",
          "emotion": "happy",
          "text": "End of the current loop. The creature is not perfect. It is bonded, changing, and maybe already choosing what it wants to become."
        }
      ],
      "choices": [
        {
          "label": "I protect it, even against our own conclusions.",
          "effects": {
            "conciliation": 3,
            "pressure": 0.35,
            "stability": 1.05,
            "mercy": true
          },
          "next": "final"
        },
        {
          "label": "I let it leave toward whatever is calling it.",
          "effects": {
            "exploration": 3,
            "pressure": 1.25,
            "overdrive": true
          },
          "next": "final"
        },
        {
          "label": "I stay with it to learn without pretending to finish it.",
          "effects": {
            "intelligence": 2,
            "conciliation": 1,
            "pressure": 0.35,
            "stability": 0.95,
            "mercy": true
          },
          "next": "final"
        }
      ]
    }
  }
