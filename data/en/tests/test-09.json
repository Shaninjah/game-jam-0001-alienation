{
  "id": "test_09",
  "label": "Behavioral test 09",
  "creatureLabel": "LEVEL 9",
  "startNode": "intro",
  "nodes": {
    "intro": {
      "messages": [
        {
          "speaker": "Professor Chen",
          "emotion": "serious",
          "text": "Ninth protocol. Command wants to test a complete separation. The creature will be moved outside your sensory range."
        }
      ],
      "choices": [
        {
          "label": "I accept the separation to prove it can obey without me.",
          "effects": {
            "force": 1,
            "intelligence": 2,
            "pressure": 0.35,
            "stability": 0.95,
            "mercy": true
          },
          "next": "dilemme_01"
        },
        {
          "label": "I refuse: the bond is still too unstable.",
          "effects": {
            "conciliation": 2,
            "pressure": 0.6,
            "stability": 0.35
          },
          "next": "dilemme_01"
        },
        {
          "label": "I ask for more time to observe what it anticipates.",
          "effects": {
            "exploration": 2,
            "intelligence": 1,
            "pressure": 0.55,
            "stability": 0.25
          },
          "next": "dilemme_01"
        }
      ]
    },
    "dilemme_01": {
      "messages": [
        {
          "speaker": "Professor Chen",
          "emotion": "worried",
          "text": "At ten meters from you, it panics. At fifteen meters, it stops moving. At twenty meters, your own hands begin to shake."
        }
      ],
      "choices": [
        {
          "label": "I hold the line and let the protocol finish.",
          "effects": {
            "force": 2,
            "pressure": 0.35,
            "stability": 0.7,
            "mercy": true
          },
          "next": "decision_finale"
        },
        {
          "label": "I turn the exercise into independence training.",
          "effects": {
            "intelligence": 1,
            "conciliation": 2,
            "pressure": 0.35,
            "stability": 0.6
          },
          "next": "decision_finale"
        },
        {
          "label": "I follow the mental image it sends during separation.",
          "effects": {
            "exploration": 2,
            "pressure": 0.8
          },
          "next": "decision_finale"
        }
      ]
    },
    "decision_finale": {
      "messages": [
        {
          "speaker": "Professor Chen",
          "emotion": "neutral",
          "text": "We have reached the sensitive point: who decides its future, the laboratory, you, or the creature itself?"
        }
      ],
      "choices": [
        {
          "label": "Military protocol decides while the risk remains.",
          "effects": {
            "force": 2,
            "intelligence": 1,
            "pressure": 0.35,
            "stability": 0.95,
            "mercy": true
          },
          "next": "final"
        },
        {
          "label": "The bond decides: we need to learn together.",
          "effects": {
            "conciliation": 3,
            "pressure": 1.05,
            "stability": 0.35,
            "overdrive": true
          },
          "next": "final"
        },
        {
          "label": "It decides, even if its answer escapes us.",
          "effects": {
            "exploration": 2,
            "conciliation": 1,
            "pressure": 0.35,
            "stability": 0.25
          },
          "next": "final"
        }
      ]
    }
  }
}
